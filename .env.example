# ローカル開発用のサンプル値です。コピーして .env を作ってください（cp .env.example .env）
# 本番ではこの値をそのまま使わず、推測されにくい値に変えてください

# データベース
DB_ROOT_PASSWORD=password
DB_NAME=scoremanager
DB_USER=smuser
DB_PASS=smpass

# 動作環境（development または production）
APP_ENV=development

# リダイレクト先のURL（例：https://example.com）。空なら相対パスでリダイレクトする
APP_URL=
